__pycache__/
*.pyc

# 本地开发环境（按规范叫 venv）。不进 git —— 谁需要谁自己建。
venv/
.build-venv/

# 用户的运行时数据
user_data/

# 构建产物：由 tools/build.py 现场产出，不进 git
# （解放行版时把 moss.exe + system\ 一起拷走即可）
moss.exe
# 打包时产物先落 moss.build.exe，编完再"结束旧进程 + 替换"成 moss.exe（`V-384`）。
moss.build.exe
# 下面两种是**老方案**的残渣名（热改名留下的 moss.exe.old-*、V-380~V-383 的 moss.exe.exe）。
# 现在不再产生，但盘上可能还有，继续挡着。
moss.exe.old*
moss.exe.exe
# nuitka 的中间产物
moss.build/
moss.dist/
moss.onefile-build/
nuitka-crash-report.xml

# 发行/打包输出目录（`moss/` + `moss.zip`，实测 261 MB / 7500+ 文件）：
# 它是 `moss.exe` + 整个 `system/` 的副本，随时能由 build + 复制重新产出 —— 不进 git。
打包专用目录/

# 生成物：图标预览图，用 tools/图标优化.py 随时能再生成
*.preview.png


# IDE
.idea/
.vscode/

# 自带运行时：181MB / 7864 个文件的二进制，不进 git 历史。
# 用 tools/拉取运行时.py 恢复。发行包里 system/ 会整体打包，不受影响。
system/runtimes/*/

*.log

# `unwx`（微信小程序反编译）不放发行版/仓库里 —— 它带一个 36 MB 的第三方 exe（KillWxapkg），
# 属于"绕过技术保护措施"的工具；按 `H-08` 放**用户层** `user_data/pkgs/unwx/`（不进仓库、不进发行版）。
/system/pkgs/unwx/

# 运行期产物（`V-133`）：pid / 日志这类东西**属于用户目录**（`user_data/state/<包id>/`），不该出现在包目录里 —— 也不该被提交。
system/pkgs/**/*.pid
system/pkgs/**/*.log
