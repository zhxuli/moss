{
  "python": {
    "label": "Python",
    "ext": [".py", ".pyw"],
    "markers": ["pyproject.toml", "requirements.txt", "setup.py", "venv", ".venv", "Pipfile"],

    "runtime": "python",
    "_runtimeNote": "自带运行时在 system/runtimes/python/。加别的解释器就再建 system/runtimes/<名字>/",

    "interpreters": {
      "_note": "两组顺序不同，照抄 pa.py 的既有语义：包调用先用自带的（保证依赖在），路径调用先尊重项目 venv",
      "package": [
        "{runtime}\\python.exe",
        "PATH:python",
        "PATH:python3"
      ],
      "path": [
        "{cwd}\\venv\\Scripts\\python.exe",
        "{cwd}\\.venv\\Scripts\\python.exe",
        "{runtime}\\python.exe",
        "PATH:python",
        "PATH:python3"
      ]
    },
    "launch": ["{interpreter}", "{entry}"]
  },

  "go": {
    "label": "Go",
    "ext": [".go"],
    "markers": ["go.mod", "go.sum"],
    "interpreters": ["PATH:go"],
    "launch": ["{interpreter}", "run", "{entry}"]
  },

  "html": {
    "label": "网页",
    "ext": [".html", ".htm"],
    "markers": [],
    "builtin": "openHtml"
  },

  "powershell": {
    "label": "PowerShell",
    "ext": [".ps1"],
    "markers": [],
    "interpreters": ["PATH:powershell", "PATH:pwsh"],
    "launch": ["{interpreter}", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{entry}"]
  },

  "shell": {
    "label": "CMD",
    "ext": [".bat", ".cmd"],
    "markers": [],
    "interpreters": ["PATH:cmd"],
    "launch": ["{interpreter}", "/c", "{entry}"]
  },

  "exe": {
    "label": "可执行文件",
    "ext": [".exe"],
    "markers": [],
    "launch": ["{entry}"]
  }
}
