{
  "spec": 1,
  "id": "imgcli",
  "kind": "task",
  "version": "1.1.0",
  "name": { "zh-CN": "图片批量压缩（命令行）", "en": "Image batch compressor (CLI)" },
  "desc": { "zh-CN": "把当前目录的图片批量转成 jpg/png/webp，可指定质量与目标宽度", "en": "Batch convert images in the current directory" },
  "tags": ["图片", "压缩", "转换", "命令行"],

  "aliases": ["imgcli", "ic"],

  "runner": "python",
  "entry": { "file": "cli.py" },

  "params": [
    { "name": "args", "type": "string", "required": false,
      "desc": "参数串：格式(必须) [质量%] [宽度px] [/] [扩展名过滤;]",
      "placeholder": "webp 80% 1080px",
      "examples": ["webp 80% 1080px", "jpg 90% /", "png 75% jpg;png;"] }
  ],

  "env": { "cwd": "", "elevated": false },

  "capabilities": {
    "run": ["python"],
    "net": [],
    "fsRead": ["{cwd}"],
    "fsWrite": ["{cwd}"],
    "elevated": false
  },

  "output": { "mode": "text" },

  "origin": {
    "by": "imported",
    "from": "QuickTools/bin/soft/img/cli.py",
    "at": "2026-09-25",
    "note": "原插件目录里的命令行版本，单独拆成一个包"
  },

  "ai": { "expose": true, "risk": "low",
          "examples": [{ "args": "webp 80%" }] }
}
