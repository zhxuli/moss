{
  "spec": 1,
  "id": "ip",
  "kind": "task",
  "version": "1.0.0",
  "name": {
    "zh-CN": "IP 查询",
    "en": "IP lookup"
  },
  "desc": {
    "zh-CN": "查询本机当前网络 IP，或指定 IP 的归属信息（走 ip-api.com，需要联网）",
    "en": "Look up the current public IP, or the geolocation of a given IP"
  },
  "tags": [
    "网络",
    "ip",
    "查询"
  ],
  "aliases": [
    "ip"
  ],
  "runner": "python",
  "entry": {
    "file": "run.py"
  },
  "params": [
    {
      "name": "target",
      "type": "string",
      "required": false,
      "desc": "要查的 IP；不填则查本机当前出口 IP",
      "placeholder": "8.8.8.8"
    }
  ],
  "env": {
    "cwd": "",
    "elevated": false
  },
  "capabilities": {
    "run": [
      "python"
    ],
    "net": [
      "ip-api.com"
    ],
    "clipboard": [],
    "elevated": false
  },
  "output": {
    "mode": "json",
    "schema": {
      "ok": "bool",
      "ip": "string",
      "country": "string",
      "region": "string",
      "city": "string",
      "isp": "string"
    }
  },
  "ai": {
    "expose": true,
    "risk": "low",
    "examples": [
      {
        "target": "8.8.8.8"
      },
      {}
    ]
  }
}