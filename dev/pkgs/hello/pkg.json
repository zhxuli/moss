{
  "spec": 1,
  "id": "hello",
  "kind": "task",
  "version": "1.0.0",
  "name": { "zh-CN": "打个招呼", "en": "Say hello" },
  "desc": { "zh-CN": "演示：类型化参数 + 结构化返回", "en": "Demo: typed params + structured output" },
  "tags": ["demo", "python"],
  "aliases": ["hello", "hi"],

  "runner": "python",
  "entry": { "file": "run.py" },

  "params": [
    { "name": "who", "type": "string", "default": "世界", "desc": "跟谁打招呼" },
    { "name": "times", "type": "int", "default": 1, "desc": "说几遍（1-100）" }
  ],

  "env": { "cwd": "", "elevated": false },

  "capabilities": { "run": ["python"], "net": [], "elevated": false },

  "output": { "mode": "json", "schema": { "who": "string", "times": "int", "greeting": "string" } },

  "verify": { "smoke": { "run": "python run.py", "expectExit": 0 } },

  "origin": { "by": "builtin" },

  "ai": { "expose": true, "risk": "low", "examples": [{ "who": "moss", "times": 2 }] }
}
