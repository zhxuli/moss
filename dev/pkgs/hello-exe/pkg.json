{
  "spec": 1,
  "id": "hello-exe",
  "kind": "task",
  "version": "1.0.0",
  "name": { "zh-CN": "Go 编译版打招呼", "en": "Hello (compiled Go)" },
  "desc": { "zh-CN": "对比演示：出厂包应该是编译好的 exe，不是需要工具链的源码", "en": "Shipped Go packages should be compiled exes" },
  "tags": ["demo", "go", "exe"],
  "aliases": ["helloexe", "hiexe"],

  "runner": "exe",
  "entry": { "file": "main.exe" },

  "params": [
    { "name": "who", "type": "string", "default": "世界", "desc": "跟谁打招呼" },
    { "name": "times", "type": "int", "default": 1, "desc": "说几遍" }
  ],

  "env": { "cwd": "", "elevated": false },

  "capabilities": { "run": ["exe"], "net": [], "elevated": false },

  "output": { "mode": "json" },

  "origin": { "by": "builtin" },

  "ai": { "expose": true, "risk": "low", "examples": [{ "who": "moss" }] }
}
